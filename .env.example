# ========================================================
# TEST YOUR ENGINEERING BRAIN - Environment Variables
# ==========================================

# Server Configuration
PORT=3000

# Administrator Security Access Key
ADMIN_PASSWORD=IEI@Engineering2026

# Email Delivery Configuration
# Choose either Resend (Option 1) or SMTP (Option 2)

# --- Option 1: Resend API (Recommended for Vercel / Cloud) ---
# Sign up at https://resend.com, generate an API key, and paste below:
RESEND_API_KEY=your_resend_api_key_here

# --- Option 2: SMTP / SendGrid / Gmail ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Outgoing Sender Identity
FROM_EMAIL=iei@drmgrdu.ac.in
FROM_NAME="MGR IEI Students Chapter"
